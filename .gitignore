# Secrets — never commit (ElevenLabs key lives in the shell env, not in files)
.env
.env.*
*.pem

# Per-video working output belongs in the user's project, not in the skill repo
video/
audio/
renders/
*.mp4
*.mov
*.wav
*.mp3
*.response.json
words.json
beats.json

# Tooling / OS junk
node_modules/
.DS_Store
*.log
*.tmp
*.bak
*~
.hyperframes/
.waveform-cache/
.thumbnails/

# Local-only agent caches (the sapu contract, its aliases and the project plugin settings are committed)
graft/
.claude/*
!/.claude/settings.json
!/.claude/sapu.json
!/.claude/sapu/
!/.claude/skills/
__pycache__/
